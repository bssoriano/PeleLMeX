#----------------------DOMAIN DEFINITION------------------------
# https://amrex-combustion.github.io/PeleLMeX/LMeXControls.html
geometry.is_periodic = 0 0 1              # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     =  0.0   0.0  -0.0125       # x_lo y_lo (z_lo)
geometry.prob_hi     =  0.025 0.00625 0.0125        # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
# STM: NoSlipWallIsotherm crashes?
peleLM.lo_bc = SlipWallAdiab NoSlipWallAdiab Interior 
peleLM.hi_bc = NoSlipWallAdiab NoSlipWallAdiab Interior 

#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 384 96 384
amr.v               = 1                # AMR verbose
amr.max_level       = 2                # maximum level number allowed
amr.ref_ratio       = 2 2 2 2          # refinement ratio
amr.regrid_int      = 1000             # how often to regrid
amr.n_error_buf     = 2 2 2 2          # number of buffer cells in error est
amr.grid_eff        = 0.95              # what constitutes an efficient grid
amr.blocking_factor = 16               # block factor in grid generation (min box size)
amr.max_grid_size   = 32               # max box size

#--------------------------- Problem -------------------------------
prob.P_mean = 2.0e+6
prob.T_mean = 700.0
prob.T_wall = 500.0
prob.meanFlowMag = 5.0
prob.problem_type = 2
prob.meanFlowDir = 2

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 3
peleLM.incompressible = 0
peleLM.gradP0 = 0.0 0.0 -8.774E+03
prob.gradP0 = 8.774E+03
peleLM.do_periodic_channel = 2
peleLM.periodic_channel_dir = 2

peleLM.typical_values_reset_int = 10

# Temporals
peleLM.do_temporals = 1
peleLM.temporal_int = 10
peleLM.do_mass_balance = 1

# amr.max_step = 000
amr.stop_time = 2.01E-02 #1.34E-02
amr.cfl = 0.7
# amr.dt_shrink = 0.01

peleLM.chem_integrator   = "ReactorNull"   # Chemistry integrator, from PelePhysics available list

#-------------------------IO CONTROL----------------------------
amr.checkpoint_files_output = 1
amr.restart = chk05510
amr.check_file          = chk          # root name of checkpoint file
amr.check_int           = 500           # number of timesteps between checkpoints
amr.plot_file           = plt          # root name of plot file
# amr.plot_int            = 50          # number of timesteps between plot files
amr.plot_per            = 5.e-4
amr.derive_plot_vars    = mag_vel mag_vort avg_pressure mass_fractions
amr.grid_log            = grdlog       # name of grid logging file

#--------------------REFINEMENT CONTROL------------------------
#amr.refinement_indicators = temp
#amr.temp.max_level     = 2
#amr.temp.value_greater = 305
#amr.temp.field_name    = temp

amr.refinement_indicators = yLow yHigh
amr.yLow.in_box_lo = -0.001 -0.0085 -0.0125 
amr.yLow.in_box_hi =  0.025  0.0006  0.0125 

amr.yHigh.in_box_lo = -0.001 0.00565 -0.0125 
amr.yHigh.in_box_hi =  0.025 0.008  0.0125  

#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1
