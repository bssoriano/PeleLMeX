#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0                # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     = 0.0  0.0  -0.34      # x_lo y_lo (z_lo)
geometry.prob_hi     = 0.68 1.36  0.34      # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Inflow  Inflow  Outflow
peleLM.hi_bc = Outflow Outflow Outflow


#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 96 192 96        # Level 0 number of cells in each direction   
amr.v               = 1                # AMR verbose
amr.max_level       = 3                # maximum level number allowed
amr.ref_ratio       = 2 2 2 2          # refinement ratio
amr.regrid_int      = 2                # how often to regrid
amr.n_error_buf     = 1 1 2 2          # number of buffer cells in error est
amr.grid_eff        = 0.7              # what constitutes an efficient grid
amr.blocking_factor = 16               # block factor in grid generation (min box size)
amr.max_grid_size   = 64               # max box size

#--------------------------- Problem -------------------------------
prob.T_mean = 298.0
prob.P_mean = 101325.0
prob.meanFlowMag = 2.3
prob.meanFlowDir = 2
prob.jet_loc = 0.0 0.136 0.0
prob.jet_radius = 0.00206 #0.00206
prob.jet_vel = 33.9
prob.jet_T = 298.
prob.jet_Yfuel = 1.0
prob.t_tr = 3.81944e-4 #time start of injection of fresh mixture
prob.Ktr  = 1.e-4 #parameter controling transition width between fresh mixture and products

#------------  INPUTS TO CONSTANT TRANSPORT -----------------
transport.const_viscosity        = 0.0001 
transport.const_bulk_viscosity   = 0.0 
transport.const_conductivity     = 0.0 
transport.const_diffusivity      = 0.0 

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 1
peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 0.0003
peleLM.EBinflow = 1
peleLM.deltaT_crashIfFailing = 0

amr.plot_int = 20
amr.max_step = 2000
amr.dt_shrink = 0.1
amr.stop_time = 0.01
amr.cfl = 0.7
amr.derive_plot_vars = avg_pressure mag_vort mag_vel mass_fractions

#------------------------- EB SETUP -----------------------------
eb2.geom_type = cylinder
eb2.cylinder_radius     = 5.555e-3 #3.06mm radius gives a 1mm wall between inflow jet and cylinder 
eb2.cylinder_direction  = 0
eb2.cylinder_center     = 0.0 0.136 0.0
eb2.cylinder_height     = 0.272
eb2.cylinder.internal_flow    = false
eb2.cylinder_has_fluid_inside = 0
eb2.small_volfrac = 1.0e-6

#------------------------- CHEMISTRY SOLVER  -----------------------------
peleLM.chem_integrator = "ReactorCvode"
# peleLM.chem_integrator = "ReactorNull"
peleLM.use_typ_vals_chem = 1          # Use species/temp typical values in CVODE
# ode.rtol = 1.0e-7                     # Relative tolerance of the chemical solve
# ode.atol = 1.0e-6                     # Absolute tolerance factor applied on typical values
cvode.solve_type = denseAJ_direct     # CVODE Linear solve type (for Newton direction) 
cvode.max_order  = 4                  # CVODE max BDF order. 

#--------------------REFINEMENT CONTROL------------------------
amr.refinement_indicators = prod hrr
amr.prod.max_level     = 2
amr.prod.value_greater = 1.e-5
amr.prod.field_name    = Y(CO2)

amr.hrr.max_level     = 2
amr.hrr.value_greater = 1.e-7
amr.hrr.field_name    = HeatRelease

#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1

##--------------------REFINEMENT CONTROL------------------------
