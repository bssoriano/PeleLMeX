#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0                # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     = 0.0 0.0         # x_lo y_lo (z_lo)
geometry.prob_hi     =  0.7 1.4   # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Inflow  Inflow  
peleLM.hi_bc = Outflow Outflow


#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 96 192         # Level 0 number of cells in each direction   
amr.v               = 1                # AMR verbose
amr.max_level       = 0                # maximum level number allowed
amr.ref_ratio       = 2 2 2 2          # refinement ratio
amr.regrid_int      = 2                # how often to regrid
amr.n_error_buf     = 1 1 2 2          # number of buffer cells in error est
amr.grid_eff        = 0.7              # what constitutes an efficient grid
amr.blocking_factor = 16               # block factor in grid generation (min box size)
amr.max_grid_size   = 64               # max box size

#--------------------------- Problem -------------------------------
prob.T_mean = 298.0
prob.P_mean = 101325.0
prob.meanFlowMag = 2.3
prob.meanFlowDir = 2
prob.inject_loc = 0.0 0.102 0.0
prob.injection_diam = 0.00412


#------------  INPUTS TO CONSTANT TRANSPORT -----------------
transport.const_viscosity        = 0.0001 
transport.const_bulk_viscosity   = 0.0 
transport.const_conductivity     = 0.0 
transport.const_diffusivity      = 0.0 

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 1
peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 0.0003

amr.plot_int = 20
amr.max_step = 2000
amr.dt_shrink = 0.1
amr.stop_time = 0.2
amr.cfl = 0.7
amr.derive_plot_vars = avg_pressure mag_vort

#------------------------- EB SETUP -----------------------------
eb2.geom_type = cylinder
eb2.cylinder_radius     = 0.00306 #1mm wall between inflow jet and cylinder 
eb2.cylinder_direction  = 0
eb2.cylinder_center     = 0.0 0.10406 0.0
eb2.cylinder.internal_flow    = false
eb2.cylinder_has_fluid_inside = 0
eb2.small_volfrac = 1.0e-6

